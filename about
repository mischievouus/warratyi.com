        Engine Context // Operational 2026
    </footer>

    <script>
        lucide.createIcons();

        // Adds or removes paragraph fields dynamically
        function adjustParagraphs(direction) {
            const container = document.getElementById('paragraphContainer');
            const currentBoxes = container.getElementsByClassName('p-box');
            
            if (direction === 1) {
                const nextIndex = currentBoxes.length + 1;
                const newParagraph = document.createElement('div');
                newParagraph.className = 'space-y-1.5 p-box';
                newParagraph.innerHTML = `
                    <span class="text-[10px] text-neutral-600 uppercase tracking-wider block">Paragraph ${nextIndex}</span>
                    <textarea class="paragraph-input w-full h-24 bg-[#050505] border border-neutral-900 p-3 text-xs text-neutral-300 rounded-none resize-none transition-colors duration-200" placeholder="Enter text narrative here..."></textarea>
                `;
                container.appendChild(newParagraph);
            } else if (direction === -1 && currentBoxes.length > 1) {
                container.removeChild(currentBoxes[currentBoxes.length - 1]);
            }
        }

        // Compiles data fields into structured clean HTML markup matching your site layout rules
        function compileAboutSection() {
            const titleValue = document.getElementById('sectionTitle').value.trim() || 'About the Project';
            const textareas = document.getElementsByClassName('paragraph-input');
            const outputWrapper = document.getElementById('outputWrapper');
            const htmlOutput = document.getElementById('htmlOutput');
            const livePreview = document.getElementById('livePreview');

            let paragraphBlocksMarkup = '';
            
            // Loop over all text inputs to clean strings and wrap in structural semantic paragraph tags
            for (let i = 0; i < textareas.length; i++) {
                const text = textareas[i].value.trim();
                if (text) {
                    paragraphBlocksMarkup += `                <p>\n                    ${text}\n                </p>\n`;
                }
            }

            // Clean structure containing your precise spacing guidelines and Lucide structural definitions
            const finalHtml = `        <!-- About Section -->
        <section id="about" class="space-y-6 scroll-mt-24 border-t border-neutral-900 pt-12">
            <div class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-neutral-400 font-semibold">
                <i data-lucide="user" class="w-4 h-4"></i>
                <h2>${titleValue}</h2>
            </div>
            <div class="text-neutral-400 text-sm space-y-4 leading-relaxed max-w-2xl">
${paragraphBlocksMarkup}            </div>
        </section>`;

            // Update parameters inside verification screens
            htmlOutput.value = finalHtml;
            livePreview.innerHTML = finalHtml;
            outputWrapper.classList.remove('hidden');

            // Force Lucide system to draw icons dynamically in preview render box window context
            lucide.createIcons();
            
            // Auto scroll down smoothly to show verification data blocks
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        }

        function copyCode() {
            const copyTextElement = document.getElementById("copyText");
            const outputField = document.getElementById("htmlOutput");

            outputField.select();
            outputField.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(outputField.value);

            outputField.classList.add('success-flash');
            copyTextElement.innerText = "Copied Setup!";
            
            setTimeout(() => {
                outputField.classList.remove('success-flash');
                copyTextElement.innerText = "Copy Code";
            }, 1500);
        }
    </script>
</body>
</html>
